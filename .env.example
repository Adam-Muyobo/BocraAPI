# Documents the environment variables required to run the BOCRA API safely.

# Local Docker compose defaults
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bocra_api?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=bocra
SPRING_DATASOURCE_PASSWORD=bocra
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
JWT_SECRET=replace_with_a_base64_or_32_plus_character_secret
JWT_EXPIRATION=3600000
REFRESH_TOKEN_EXPIRATION=1209600000
EMAIL_VERIFICATION_EXPIRATION=86400000
EMAIL_VERIFICATION_LOG_GENERATED_TOKEN=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010
DEMO_DATA_ENABLED=true

# Production overrides for Render and Aiven
# SPRING_PROFILES_ACTIVE=production
# SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<database>?sslMode=REQUIRED&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=<aiven-username>
# SPRING_DATASOURCE_PASSWORD=<aiven-password>
# CORS_ALLOWED_ORIGINS=https://<your-vercel-domain>
# DEMO_DATA_ENABLED=false
